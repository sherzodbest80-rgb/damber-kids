# ==========================================================
#  DAMBER KIDS — Environment Variables
#  Bu faylni nusxalab .env.local nomi bilan saqlang (lokal test uchun).
#  Vercel'da esa har birini Settings > Environment Variables ga qo'shing.
# ==========================================================

# ---- 1) TELEGRAM (majburiy — lidlar shu yerga tushadi) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# ---- 2) META CAPI (sifatli konversiya — Business Manager tayyor bo'lgach) ----
# Brauzer Pixel'i uchun (NEXT_PUBLIC_ bo'lishi SHART):
NEXT_PUBLIC_META_PIXEL_ID=
# Server CAPI uchun (bir xil Pixel ID):
META_PIXEL_ID=
META_CAPI_TOKEN=

# ---- 3) AMOCRM (ixtiyoriy — pipeline tayyor bo'lgach) ----
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
